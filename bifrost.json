{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true,
    "enforce_auth_on_inference": true
  },
  "providers": {
    "openai": {
      "keys": [
        {
          "id": "openai-primary",
          "name": "openai-primary",
          "value": "env.OPENAI_API_KEY",
          "models": [
            "gpt-5.5",
            "gpt-5.4",
            "gpt-5.4-mini",
            "gpt-5.4-nano",
            "text-embedding-3-small",
            "gpt-4o-mini-transcribe"
          ],
          "weight": 1.0
        }
      ]
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "opencto-local",
        "name": "opencto-local",
        "value": "env.BIFROST_API_KEY",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "openai",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "openai-primary"
            ],
            "weight": 1.0
          }
        ]
      }
    ]
  },
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.POSTGRES_HOST",
      "port": "env.POSTGRES_PORT",
      "user": "env.POSTGRES_USER",
      "password": "env.POSTGRES_PASSWORD",
      "db_name": "env.POSTGRES_DB",
      "ssl_mode": "disable"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.POSTGRES_HOST",
      "port": "env.POSTGRES_PORT",
      "user": "env.POSTGRES_USER",
      "password": "env.POSTGRES_PASSWORD",
      "db_name": "env.POSTGRES_DB",
      "ssl_mode": "disable"
    }
  }
}
