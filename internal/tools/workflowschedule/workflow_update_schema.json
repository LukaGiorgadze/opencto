{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["workflow_id"],
  "additionalProperties": false,
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cron": {"type": "string"},
        "one_shot_at": {"type": "string"},
        "overlap_policy": {"type": "string", "enum": ["", "skip", "buffer_one", "buffer_all", "cancel_other", "terminate_other", "allow_all"]},
        "catchup_window": {"type": "string"},
        "pause_on_failure": {"type": "boolean"}
      }
    },
    "notification_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_failure": {"type": "boolean"}
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*=.*$",
        "description": "Global env assignment NAME=value applied to every step. Runtime-owned OPENCTO_* names are reserved."
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command", "start_to_close_timeout"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
          "args": {"type": "array", "items": {"type": "string"}},
          "start_to_close_timeout": {"type": "string"},
          "schedule_to_close_timeout": {"type": "string"},
          "retry_policy": {
            "type": "object",
            "required": [],
            "additionalProperties": false,
            "properties": {
              "initial_interval": {"type": "string"},
              "backoff_coefficient": {"type": "number", "minimum": 0},
              "maximum_interval": {"type": "string"},
              "maximum_attempts": {"type": "integer", "minimum": 0},
              "non_retryable_error_types": {
                "type": "array",
                "items": {"type": "string", "enum": ["WorkflowStepFailed"]},
                "description": "Use [\"WorkflowStepFailed\"] to make command failures non-retryable, or [] to use retry attempts."
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "pattern": "^src/.+"},
          "content": {"type": "string"},
          "executable": {"type": "boolean"}
        }
      }
    },
    "commit_message": {"type": "string"},
    "paused": {"type": "boolean"},
    "note": {"type": "string"}
  }
}
